# Copy to .env and fill in. One Sentry project (platform: Astro) is enough —
# browser and server events share it and are linked by trace id.
#   cp .env.template .env

# Browser SDK. PUBLIC_ vars are inlined into client JS at BUILD time,
# so rebuild after changing them.
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENVIRONMENT=local
PUBLIC_SENTRY_RELEASE=empower-astro@1.0.0

# Server SDK. Read at RUNTIME (npm start loads .env).
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=empower-astro@1.0.0
SENTRY_DEBUG=false

# Optional: source-map upload during `npm run build` (skipped when blank).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# empower-local's Flask backend, as seen from the Astro SERVER (runtime).
BACKEND_URL=http://localhost:8080
