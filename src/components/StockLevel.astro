---
// SERVER ISLAND. Used with `server:defer`, so the page around it can be fully
// static (prerendered) while this fragment is fetched from the server after load
// via GET /_server-islands/StockLevel. That request is its own http.server span.
import { getInventory } from '../lib/db';
import { PRODUCTS } from '../lib/data';

const stock = await getInventory(PRODUCTS.map((p) => p.id));
const byId = new Map(stock.map((s) => [s.productId, s.count]));
---

<ul class="stock">
  {
    PRODUCTS.map((p) => {
      const n = byId.get(p.id) ?? 0;
      return (
        <li class={n <= 0 ? 'out' : n === 1 ? 'low' : ''}>
          {p.title}: {n <= 0 ? 'sold out' : `${n} left`}
        </li>
      );
    })
  }
</ul>
<p class="muted small">Live inventory, rendered {new Date().toLocaleTimeString()}</p>
